# ==============================================================================
# AO Sphere BOS — Production Environment Variables Template
# Copy this file to .env before starting the production docker compose stack.
# ==============================================================================

# Core Application Settings
AOSPHERE_ENV=production
AOSPHERE_PORT=8080
AOSPHERE_LOG_LEVEL=info
AOSPHERE_DB_PATH=/var/lib/aosphere/data/aosphere.db
AOSPHERE_SEED=false

# Domain & TLS Proxy (Caddy uses this to obtain automatic Let's Encrypt certificates)
DOMAIN=aosphere.example.com

# Cryptographic Session & Auth Secrets (Generate using: openssl rand -hex 32)
AOSPHERE_SESSION_SECRET=replace_with_a_64_character_hex_random_secret_key_here
AOSPHERE_JWT_SECRET=replace_with_a_64_character_hex_random_jwt_secret_here

# Disaster Recovery & Encrypted Backup Passphrase (AES-256-GCM)
BACKUP_PASSPHRASE=replace_with_secure_long_backup_encryption_passphrase
BACKUP_INTERVAL_HOURS=6

# Cloud S3 / Cloudflare R2 / MinIO Backup Replication
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=aosphere-production-backups
S3_REGION=auto
S3_ACCESS_KEY=your_s3_access_key_id
S3_SECRET_KEY=your_s3_secret_access_key

# Admin User Bootstrapping
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin2026!

