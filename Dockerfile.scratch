# syntax=docker/dockerfile:1.4
# Multi-stage scratch build for AO Sphere BOS (zero-dependency static binary)

# ----------------- Stage 1: Build -----------------
FROM golang:1.24-alpine AS builder

WORKDIR /src

# Install CA certificates and build essentials
RUN apk add --no-cache ca-certificates tzdata git

# Cache Go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy source code and assets
COPY . .

# Compile 100% statically linked binary without libc or CGO dependencies
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags="-s -w -extldflags '-static'" \
    -o /bin/aosphere .

# ----------------- Stage 2: Scratch Runtime -----------------
FROM scratch

WORKDIR /app

# Copy SSL certificates from builder
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy binary, web dashboard assets, and configs
COPY --from=builder /bin/aosphere /app/aosphere
COPY --from=builder /src/web /app/web
COPY --from=builder /src/config /etc/aosphere/config

# Persistent data volumes and network port
VOLUME ["/var/lib/aosphere/data"]
EXPOSE 8080

# Environment defaults
ENV AOSPHERE_ENV=production \
    AOSPHERE_PORT=8080 \
    AOSPHERE_DB_PATH=/var/lib/aosphere/data/aosphere.db \
    AOSPHERE_SEED=false \
    AOSPHERE_LOG_LEVEL=info

ENTRYPOINT ["/app/aosphere"]

